GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=your_tavily_search_api_key
SITE_NICHE=home-decor
SITE_NAME=Urban Nest Interiors
SITE_DESCRIPTION=Practical ideas and thoughtful guides for better home interiors.
SITE_TAGLINE=Practical ideas for thoughtful, comfortable spaces.
SITE_EYEBROW=THE URBAN NEST JOURNAL
PUBLISHER_LOGO_URL=
CONTACT_EMAIL=
EDITORIAL_NOTIFICATION_EMAIL=
EDITORIAL_TEAM_NAME=Urban Nest Interiors Editorial Team
EDITORIAL_TEAM_BIO=
APP_ENV=development
FLASK_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
DATABASE_PATH=data/site.sqlite3
UPLOADS_PATH=static/uploads
KEYWORD_STATE_PATH=data/used_keywords.json
PENDING_ARTICLE_PATH=data/pending_wordpress_article.json
ALLOW_PUBLIC_SUBMISSIONS=0
PUBLIC_SITE_URL=https://your-domain.example
# Resend API is recommended; set RESEND_API_KEY and use a verified sender domain.
RESEND_API_KEY=
# SMTP is an optional fallback when RESEND_API_KEY is not set.
NEWSLETTER_SMTP_HOST=
NEWSLETTER_SMTP_PORT=587
NEWSLETTER_SMTP_SECURITY=starttls
NEWSLETTER_SMTP_USERNAME=
NEWSLETTER_SMTP_PASSWORD=
NEWSLETTER_FROM_EMAIL=
GOOGLE_SITE_VERIFICATION=
# Search Console API: verified property plus a service-account key outside Git.
GOOGLE_SEARCH_CONSOLE_PROPERTY=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_FILE=
# For Railway, use its secret variable instead of committing this JSON value.
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
WP_SITE_URL=https://your-wordpress-site.example
WP_AUTH_TOKEN=your_wordpress_jwt
INDEXNOW_KEY=your_indexnow_key
# Optional: use when the IndexNow key file is hosted at a non-default URL.
INDEXNOW_KEY_LOCATION=
TEST_MODE=1
PUBLISH_TIME=09:00
# Optional: select another profile file, for example .env.tech.
# ENV_FILE=.env
# PORT=5000